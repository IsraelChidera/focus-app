# Copy to .env and fill in. Never commit .env.

# Firebase web app config (public; bundled into the browser app)
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=

# Envelo AI (server-only; no VITE_ prefix, so these never reach the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: model to use on retries when the main one is overloaded
GEMINI_FALLBACK_MODEL=
# Optional: "low" (default) keeps answers fast; leave empty for the model's default
GEMINI_THINKING_LEVEL=low
# Seconds for the whole AI request, including retries
AI_TIMEOUT=30
MAX_RETRIES=3
